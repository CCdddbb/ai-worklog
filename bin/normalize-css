# Print targets paper, not the screen token table (docs/design-system.md).
PRINT_EXEMPT = {
    ('color', '#111'),
}

SHADOW_LITERALS = {
    '0 2px 4px #3158d414': 'var(--shadow-accent)',
    '0 3px 12px #20375b0a': 'var(--shadow-raised)',
}

PX = re.compile(r'(?<![\w.-])(\d+(?:\.\d+)?)px\b')
HEX = re.compile(r'#[0-9a-fA-F]{3,8}\b')
DECL = re.compile(r'([a-z-]+)(\s*:\s*)([^;{}]+)(;)')


def nearest(value: float, table: dict[int, str]) -> str:
    key = min(table, key=lambda k: (abs(k - value), k))
    return f'var({table[key]})'


def tokenize_px(value: str, table: dict[int, str]) -> str:
    def repl(match: re.Match[str]) -> str:
        return nearest(float(match.group(1)), table)
    return PX.sub(repl, value)


def normalise_decl(prop: str, value: str) -> str:
    if prop in SPACING_PROPS:
        return tokenize_px(value, SPACING)
    if prop == 'font-size':
        return tokenize_px(value, TYPE)
    if prop == 'border-radius':
        if value.strip() == '50%':
            return value
        return tokenize_px(value, RADIUS)
    return value


def segments(text: str) -> list[tuple[str, bool]]:
	"""Split CSS into chunks, flagging chunks inside @media print blocks.

	Print targets paper and keeps explicit light values, so the normaliser
	must not touch them.
	"""
	parts: list[tuple[str, bool]] = []
	in_print = False
	depth = 0
	buf: list[str] = []
	for line in text.splitlines(keepends=True):
		stripped = line.strip()
		if not in_print and stripped.startswith('@media print'):
			in_print = True
			depth = 0
			buf = []
		if in_print:
			buf.append(line)
			depth += line.count('{') - line.count('}')
			if depth <= 0 and '{' in ''.join(buf):
				parts.append((''.join(buf), True))
				in_print = False
				buf = []
		else:
			parts.append((line, False))
	if buf:
		parts.append((''.join(buf), True))
	return parts


def normalise(text: str) -> tuple[str, int]:
	changes = 0
	out: list[str] = []
	for chunk, is_print in segments(text):
		if is_print:
			out.append(chunk)
			continue
		chunk, n = _normalise_chunk(chunk)
		changes += n
		out.append(chunk)
	return ''.join(out), changes


def _normalise_chunk(text: str) -> tuple[str, int]:
    changes = 0

    for literal, token in SHADOW_LITERALS.items():
        if literal in text:
            changes += text.count(literal)
            text = text.replace(literal, token)

    def decl(match: re.Match[str]) -> str:
        nonlocal changes
        prop, sep, value, end = match.groups()
        updated = normalise_decl(prop, value)
        if updated != value:
            changes += 1
        return f'{prop}{sep}{updated}{end}'

    text = DECL.sub(decl, text)

    def color(match: re.Match[str]) -> str:
        nonlocal changes
        token = COLORS.get(match.group(0).lower())
        if token is None:
            return match.group(0)
        changes += 1
        return f'var({token})'

    text = HEX.sub(color, text)
    return text, changes


def unmapped(text: str) -> list[str]:
	found = []
	for chunk, is_print in segments(text):
		if is_print:
			continue
		found.extend(_unmapped_chunk(chunk))
	return found


def _unmapped_chunk(text: str) -> list[str]:
    found = []
    for match in DECL.finditer(text):
        prop, _, value, _ = match.groups()
        if prop in SPACING_PROPS or prop == 'font-size' or prop == 'border-radius':
            for px in PX.findall(value):
                if float(px) not in {**SPACING, **TYPE, **RADIUS}:
                    found.append(f'{prop}: {value.strip()}')
                    break
        for hex_value in HEX.findall(value):
            if hex_value.lower() not in COLORS and (prop, hex_value.lower()) not in PRINT_EXEMPT:
                found.append(f'{prop}: {value.strip()}')
                break
    return found


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument('--check', action='store_true', help='report, do not write')
    args = parser.parse_args()
    total = 0
    leftovers: list[str] = []
    for path in FILES:
        original = path.read_text()
        text, changes = normalise(original)
        total += changes
        leftovers.extend(f'{path.name}: {item}' for item in unmapped(text))
        if args.check:
            print(f'{path.name}: {changes} literals normalisable, {len(unmapped(text))} left')
        elif text != original:
            path.write_text(text)
            print(f'{path.name}: normalised {changes} literals')
        else:
            print(f'{path.name}: already normalised')
    if args.check and leftovers:
        print('\nUnmapped values:')
        for item in leftovers:
            print('  ' + item)
    return 0


if __name__ == '__main__':
    sys.exit(main())
