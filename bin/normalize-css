#!/usr/bin/env python3
"""Normalise CSS literals to the design-token table.

Only spacing properties (margin/padding/gap), font-size and border-radius are
rewritten. Colours are mapped when an exact semantic token exists. Layout
dimensions (width/height/top/left) are intentionally left alone.

Usage:
    bin/normalize-css            # rewrite static/style.css, static/workbench.css
    bin/normalize-css --check    # report remaining unmapped literals, change nothing
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
FILES = [ROOT / 'static/style.css', ROOT / 'static/workbench.css']

